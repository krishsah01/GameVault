@{
    ViewData["Title"] = "Home";
}

<section class="gv-hero rounded-4 p-5 mb-4 text-center">
    <h1 class="display-4 fw-bold">Welcome to GameVault</h1>
    <p class="lead mb-0">
        A personal vault of the video games I love &mdash; what I play, why it's great, and how I rate it.
    </p>
</section>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 gv-card">
            <div class="card-body">
                <h2 class="h5 card-title">&#127942; My Collection</h2>
                <p class="card-text">Browse favorite games stored in a SQL Server database, with genre, developer, platform and my rating.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 gv-card">
            <div class="card-body">
                <h2 class="h5 card-title">&#127912; Genres</h2>
                <p class="card-text">From open-world RPGs to precision platformers &mdash; see how my library breaks down by genre.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 gv-card">
            <div class="card-body">
                <h2 class="h5 card-title">&#128100; About</h2>
                <p class="card-text">Why gaming is my hobby, and a little about the person who built this site.</p>
            </div>
        </div>
    </div>
</div>
