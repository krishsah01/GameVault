@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="gv-hero rounded-4 p-5 mb-4 text-center">
    <h1 class="display-4 fw-bold">Welcome to GameVault</h1>
    <p class="lead mb-4">
        A personal vault of the video games I love &mdash; what I play, why it's great, and how I rate it.
    </p>
    <div class="row justify-content-center text-center g-3">
        <div class="col-4 col-md-2"><div class="h2 mb-0 gv-rating">@Model.GameCount</div><div class="small text-body-secondary">Games</div></div>
        <div class="col-4 col-md-2"><div class="h2 mb-0 gv-rating">@Model.GenreCount</div><div class="small text-body-secondary">Genres</div></div>
        <div class="col-4 col-md-2"><div class="h2 mb-0 gv-rating">@Model.DeveloperCount</div><div class="small text-body-secondary">Studios</div></div>
    </div>
</section>

<h2 class="h4 mb-3">Top-rated picks</h2>
<div class="row g-4 mb-5">
    @foreach (var game in Model.TopGames)
    {
        <div class="col-md-4">
            <div class="card h-100 gv-card">
                <div class="card-body">
                    <span class="badge text-bg-secondary mb-2">@game.Genre?.Name</span>
                    <h3 class="h5 card-title">@game.Title</h3>
                    <p class="card-text text-body-secondary">@game.Description</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center bg-transparent">
                    <span class="gv-rating">@game.MyRating / 10</span>
                    <a asp-controller="Games" asp-action="Details" asp-route-id="@game.Id" class="btn btn-sm btn-outline-info">Details</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-md-4">
        <a asp-controller="Games" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 gv-card">
                <div class="card-body">
                    <h2 class="h5 card-title">&#127942; My Collection</h2>
                    <p class="card-text">Browse favorite games stored in a SQL Server database, with genre, developer, platform and my rating.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Genres" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 gv-card">
                <div class="card-body">
                    <h2 class="h5 card-title">&#127912; Genres</h2>
                    <p class="card-text">From open-world RPGs to precision platformers &mdash; see how my library breaks down by genre.</p>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Developers" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 gv-card">
                <div class="card-body">
                    <h2 class="h5 card-title">&#127970; Studios</h2>
                    <p class="card-text">Meet the developers and studios behind the games, and where they come from.</p>
                </div>
            </div>
        </a>
    </div>
</div>
